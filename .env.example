# Offer Desk - environment configuration.
#
# Copy this file to .env.local and fill in the two values. .env.local is
# gitignored; never commit real keys.
#
#   cp .env.example .env.local
#
# Both values below come from your Supabase dashboard:
#   Project Settings -> API -> Project URL, and the "anon public" key.
#
# EXPO_PUBLIC_ variables are compiled into the client bundle, so only values
# that are safe in public belong here. The anon key is one of them: it grants
# nothing on its own, because Row-Level Security decides what any given signed-in
# user can read. The service_role key is NOT safe and must never appear in this
# file - it belongs in Edge Function secrets only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
